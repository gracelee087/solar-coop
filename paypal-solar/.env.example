# Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio API key (free tier): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# PayPal sandbox app (Developer Dashboard > Apps & Credentials > Sandbox), with Invoicing enabled
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: comma-separated Gemini models tried in order (free-tier quotas are per model)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemma-4-26b-a4b-it

# Live negotiations per day on the dashboard (each spends up to 10 free-tier Gemini calls). Default 10.
# LIVE_NEGOTIATIONS_PER_DAY=10

# TypeSafe Jev grounding experiment (experiments/jev-grounding). Real calls only with ALLOW_JEV_CALL=true, after approval.
TYPESAFE_API_KEY=
ALLOW_JEV_CALL=false
